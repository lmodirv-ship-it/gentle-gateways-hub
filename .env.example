# ===== HN Groupe — إعدادات البيئة =====
# انسخ هذا الملف إلى .env ثم عدّل القيم.

# --- الوضع المحلي (Supabase CLI: supabase start) ---
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon key من مخرجات supabase start>"
VITE_SUPABASE_PROJECT_ID="hn-groupe-local"

SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="<anon key من مخرجات supabase start>"
SUPABASE_SERVICE_ROLE_KEY="<service_role key من مخرجات supabase start>"
SUPABASE_PROJECT_ID="hn-groupe-local"

